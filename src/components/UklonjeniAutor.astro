---
// Stranica za uklonjeni profil autora: postoji samo zato da Google stari URL makne iz indeksa
// (noindex). Nije u sitemapu i nitko na nju ne vodi.
import BaseLayout from '../layouts/BaseLayout.astro';
interface Props { path: string }
const { path } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<BaseLayout title="Profil više ne postoji | Cultivias" description="Ovaj profil autora uklonjen je s portala Cultivias." canonical={path} noindex={true}>
  <div class="max-w-2xl mx-auto px-4 py-16 text-center">
    <h1 class="text-2xl font-bold font-heading text-dark mb-4">Profil više ne postoji</h1>
    <p class="text-gray-600 mb-6">Ovaj profil autora uklonjen je s portala. Članke Cultiviasa potpisuje uredništvo.</p>
    <a href={`${base}autor/redakcija/`} class="font-semibold" style="color: var(--color-primary);">Uredništvo Cultiviasa &rarr;</a>
  </div>
</BaseLayout>
