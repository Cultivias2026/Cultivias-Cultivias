---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { pageTitle } from '../../lib/naslov';
import ArticleCard from '../../components/ArticleCard.astro';
import { buildGraph, webPageNode, breadcrumbNode, abs } from '../../lib/schema';
import { publishedTags, clanciLabel, buildFacets, itemAttrs, CAT_LABELS } from '../../lib/tags';
import FacetFilter from '../../components/FacetFilter.astro';
import { TAGS, knownTags, tagPath, tagLabel } from '../../data/tags';

export async function getStaticPaths() {
  const tags = await publishedTags();
  return tags.map(t => ({ params: { tag: t.key }, props: { tagKey: t.key, articles: t.articles, allTags: tags.map(x => ({ key: x.key, count: x.articles.length })) } }));
}

const { tagKey, articles, allTags } = Astro.props;
const def = TAGS[tagKey];
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const path = tagPath(tagKey);

const categoryLabels = CAT_LABELS;

// Filtar na stranici: na stranici biljke biraju se teme, na stranici teme biljke;
// kategorija se nudi samo ako su članci iz više kategorija.
const publishedKeys = new Set(allTags.map(t => t.key));
const isPlant = def.group === 'biljka';
const facets = buildFacets(articles, { base, publishedKeys, biljka: !isPlant, tema: isPlant, kat: true });
const mainCat = articles[0]?.data.category;
// slika za dijeljenje: naslovna slika najnovijeg članka teme
const coverImage: string | undefined = articles.find(a => a.data.image)?.data.image;

const jsonLd = await buildGraph([
  webPageNode({
    type: 'CollectionPage',
    path,
    name: def.metaTitle,
    description: def.metaDescription,
    hasBreadcrumb: true,
    extra: {
      mainEntity: { '@id': `${abs(path)}#list` },
      about: { '@type': 'Thing', name: def.name },
      ...(coverImage ? { primaryImageOfPage: { '@type': 'ImageObject', url: abs(coverImage) } } : {}),
    },
  }),
  breadcrumbNode(path, [
    { name: 'Naslovnica', path: '/' },
    { name: 'Teme', path: '/tema/' },
    { name: tagLabel(tagKey), path },
  ]),
  {
    '@type': 'ItemList',
    '@id': `${abs(path)}#list`,
    name: def.name,
    numberOfItems: articles.length,
    itemListElement: articles.map((a, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: abs(`/${a.data.category}/${a.slug}/`),
      name: a.data.title,
    })),
  },
]);
---

<BaseLayout title={pageTitle(def.metaTitle)} description={def.metaDescription} canonical={path} jsonLd={jsonLd} {...(coverImage ? { image: coverImage } : {})}>
  <div data-facet-scope>
  <div class="bg-white border-b border-bg-pale">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
      <nav class="mb-4" aria-label="Navigacijska staza">
        <ol class="flex items-center gap-2 text-sm text-gray-400 flex-wrap">
          <li><a href={base} class="hover:text-primary transition-colors">Naslovnica</a></li>
          <li aria-hidden="true"><span class="text-gray-300">/</span></li>
          <li><a href={`${base}tema/`} class="hover:text-primary transition-colors">Teme</a></li>
          <li aria-hidden="true"><span class="text-gray-300">/</span></li>
          <li class="text-dark font-medium">{tagLabel(tagKey)}</li>
        </ol>
      </nav>
      <h1 class="text-2xl sm:text-4xl font-bold text-dark font-heading">{def.name}: svi članci</h1>
      <p class="text-gray-600 mt-3 max-w-3xl font-body leading-relaxed">{def.intro}</p>
      <p class="text-sm text-primary font-semibold mt-3">{articles.length} {clanciLabel(articles.length)}</p>
      <FacetFilter facets={facets} total={articles.length} extraLink={{ href: `${base}tema/`, label: 'Sve teme →' }} />
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {articles.map(article => (
        <div class="h-full" {...itemAttrs(article)}><ArticleCard
          title={article.data.title}
          slug={article.slug}
          category={article.data.category}
          author={article.data.author}
          readTime={article.data.readTime}
          image={article.data.image}
          perex={article.data.perex}
          publishedAt={article.data.publishedAt}
          variant="default"
        /></div>
      ))}
    </div>
    <p class="mt-10 text-sm text-gray-500 font-body">
      Pogledajte i <a href={`${base}tema/`} class="text-primary hover:text-primary-dark">sve teme</a> ili kategorije
      {Object.entries(categoryLabels).map(([k, v], i, arr) => (
        <>
          <a href={`${base}${k}/`} class="text-primary hover:text-primary-dark">{v}</a>{i < arr.length - 2 ? ', ' : i === arr.length - 2 ? ' i ' : '.'}
        </>
      ))}
    </p>
  </div>
  </div>
</BaseLayout>
