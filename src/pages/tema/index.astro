---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { buildGraph, webPageNode, breadcrumbNode, abs } from '../../lib/schema';
import { publishedTags, clanciLabel } from '../../lib/tags';
import { tagPath } from '../../data/tags';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const tags = (await publishedTags()).sort((a, b) => b.articles.length - a.articles.length);
const groups = [
  { title: 'Biljke i plodovi', items: tags.filter(t => t.def.group === 'biljka') },
  { title: 'Teme', items: tags.filter(t => t.def.group === 'tema') },
];
const path = '/tema/';
const description = 'Sve teme na Cultiviasu na jednom mjestu: članci o pojedinim biljkama i plodovima te o uzgoju, zdravlju, receptima, čajevima i kalorijama.';

const jsonLd = await buildGraph([
  webPageNode({ type: 'CollectionPage', path, name: 'Teme | Cultivias', description, hasBreadcrumb: true, extra: { mainEntity: { '@id': `${abs(path)}#list` } } }),
  breadcrumbNode(path, [{ name: 'Naslovnica', path: '/' }, { name: 'Teme', path }]),
  {
    '@type': 'ItemList',
    '@id': `${abs(path)}#list`,
    name: 'Teme',
    numberOfItems: tags.length,
    itemListElement: tags.map((t, i) => ({ '@type': 'ListItem', position: i + 1, url: abs(tagPath(t.key)), name: t.def.name })),
  },
]);
---

<BaseLayout title="Teme: biljke, uzgoj, recepti i zdravlje | Cultivias" description={description} canonical={path} jsonLd={jsonLd}>
  <div class="bg-white border-b border-bg-pale">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
      <nav class="mb-4" aria-label="Navigacijska staza">
        <ol class="flex items-center gap-2 text-sm text-gray-400">
          <li><a href={base} class="hover:text-primary transition-colors">Naslovnica</a></li>
          <li aria-hidden="true"><span class="text-gray-300">/</span></li>
          <li class="text-dark font-medium">Teme</li>
        </ol>
      </nav>
      <h1 class="text-3xl sm:text-4xl font-bold text-dark font-heading">Teme</h1>
      <p class="text-gray-600 mt-3 max-w-3xl font-body leading-relaxed">{description}</p>
    </div>
  </div>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-10">
    {groups.map(g => (
      <section>
        <h2 class="text-2xl font-bold text-dark font-heading mb-4">{g.title}</h2>
        <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 list-none p-0 m-0">
          {g.items.map(t => (
            <li class="bg-white rounded-2xl border border-bg-pale p-5">
              <a href={`${base}${tagPath(t.key).slice(1)}`} class="no-underline">
                <span class="block text-lg font-bold text-dark font-heading">{t.def.name}</span>
                <span class="block text-sm text-gray-500 mt-1">{t.articles.length} {clanciLabel(t.articles.length)}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</BaseLayout>
